<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" 
			 xmlns:s="library://ns.adobe.com/flex/spark" 
			 xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%">
	<fx:Script>
		/**
		 * @private
		 */
		override protected function initializationComplete():void
		{
			useChromeColor = true;
			super.initializationComplete();
		}
		
	</fx:Script>
	
	<!-- layer 1: opaque white bg fill -->
	<s:Rect left="0" right="0" top="0" bottom="0"  >
		<s:fill>
			<s:SolidColor color="#000000" alpha="1"/>
		</s:fill>
	</s:Rect>
	
	<!-- layer 2: fill -->
	<s:Rect left="0" right="0" top="0" bottom="0">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry color="#DCECFD" 
								 alpha="1" />
				<s:GradientEntry color="#DCECFD" 
								 alpha="1" />
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	
	<!-- layer 3: fill lowlight -->
	<s:Rect left="0" right="0" bottom="0" height="25"   top="1">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha=".75" color="#DCECFD" ratio="0.1"  />
				<s:GradientEntry alpha=".75" color="#B7D7EC" ratio="1"  />		
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	
	<!-- layer 4: fill highlight -->
	<s:Rect left="0" right="0" top="0" height="13">
		<s:fill>
			<s:SolidColor color="0xFFFFFF" 
						  alpha="0.05" />
		</s:fill>
	</s:Rect>
	
	<!-- layer 7: border - put on top of the fill so it doesn't disappear when scale is less than 1-->
	<s:Rect left="0" right="0" bottom="0" height="1">
		<s:fill>
			<s:SolidColor color="#87CEEB" alpha="1"/>
		</s:fill>
	</s:Rect> 
	
	

</s:SparkSkin>
