<?xml version="1.0" encoding="utf-8"?>
<mx:Label xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" height="100%">
	<fx:Declarations>
		<!-- 将非可视元素（例如服务、值对象）放在此处 -->
	</fx:Declarations>
	<fx:Script>
		<![CDATA[
			override public function set data(value:Object):void{
				super.data = value;
				this.setStyle("color",0xFF0000);
				this.toolTip=((value==null||value.zhaiyao==null)?"":value.zhaiyao+"");
			}
		]]>
	</fx:Script>
</mx:Label>
