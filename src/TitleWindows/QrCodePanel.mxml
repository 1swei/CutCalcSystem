<?xml version="1.0" encoding="utf-8"?>
<s:TitleWindow xmlns:fx="http://ns.adobe.com/mxml/2009" verticalCenter="0" horizontalCenter="0" 
			   xmlns:s="library://ns.adobe.com/flex/spark" creationComplete="titlewindow1_creationCompleteHandler(event)"
			   xmlns:mx="library://ns.adobe.com/flex/mx" width="500" height="400" title="二维码上传" close="close()">
	<fx:Script>
		<![CDATA[
			import common.DateFormatHelper;
			import common.FileUtil;
			import common.MyEncrypt;
			
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import skins.PopUpEffect;
			
			private var file:File;
			protected function titlewindow1_creationCompleteHandler(event:FlexEvent):void
			{
				file = new File();
				file.nativePath = FileUtil.desktopPath;
				file.addEventListener(Event.SELECT, selectHandler);
				if(new File(FileUtil.qrCode).exists){
					qrImg.source=FileUtil.qrCode;
				}
			}
			private function selectHandler(event:Event):void { 
				file.addEventListener(Event.COMPLETE,onComplete);
				file.load();
			}
			private function onComplete(event:Event):void
			{
				
				qrcodeName.text=file.name;
				qrImg.source = file.nativePath;
			}
			protected function button1_clickHandler(event:MouseEvent):void
			{
				file.browse([FileUtil.imageTypes]);
			}
			
			protected function save(event:MouseEvent):void
			{
				if(file.nativePath==FileUtil.desktopPath){
					Alert.show("请选择新的二维码图片再保存","提示");
					return;
				}
				var original:File = file;
				var newFile:File = new File(FileUtil.qrCode);
				original.copyTo(newFile, true);
				Alert.show("保存成功","提示");
			}
			private function close():void{
				PopUpEffect.Hide(this);
			}
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- 将非可视元素（例如服务、值对象）放在此处 -->
	</fx:Declarations>
	
	<mx:VBox width="100%" height="100%" verticalAlign="middle" horizontalAlign="center" paddingLeft="10" paddingRight="10" >
		<mx:VBox horizontalAlign="center" verticalAlign="middle">
			<s:Label text="设置公司或个人的微信二维码 ，也可设置为本公司LOGO。"/>
			<s:Label text="暂不支持bmp格式的图片"/>
			<mx:Image id="qrImg" scaleContent="true" maintainAspectRatio="false" width="120" height="120"/>
			<mx:TextInput editable="false" id="qrcodeName" textAlign="center" text="-"/>
		</mx:VBox>
		<mx:HBox width="100%" horizontalAlign="center" height="30" verticalAlign="bottom" >
			<s:Button label="选择二维码" click="button1_clickHandler(event)" buttonMode="true"/>
			<s:Button label="保存" click="save(event)" buttonMode="true" enabled="{qrImg.source}"/>
		</mx:HBox>
	</mx:VBox>
</s:TitleWindow>
