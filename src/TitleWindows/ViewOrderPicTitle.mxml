			public function workToText(array:ArrayCollection,isWk:Boolean=true):String{
				var result = isWk?"【外框料】\n":"【内扇料】\n";
				if(array!=null&&array.length){
					for(var i:int = 0;i<array.length;i++){
						var item:WorkMaterial = array.getItemAt(i) as WorkMaterial;
						result+= StringHelper.addSomeThing(item.name,8," ",1);
						result+= item.length + "cm×";
						if(item.isNameMulti){
							result+="各";
						}
						result += item.num+"\n";
						
					}
				}
				return result;
			}
			
			public function glassToText(array:ArrayCollection):String{
				var result = "【玻璃】\n";
				if(array!=null&&array.length){
					for(var i:int = 0;i<array.length;i++){
						var item:WorkGlass = array.getItemAt(i) as WorkGlass;
						result+= item.length+"×"+item.width + "cm";
						if(item.other>0){
							result+="("+item.other+")";
						}
						result += "×"+item.num+"块\n";
						
					}
				}
				return result;
			}
			
			
			protected function button3_clickHandler(event:MouseEvent):void
			{
				var panel:PriceCalcDoc=new PriceCalcDoc();
				panel.setData(item_z,orderToPrice(item_z));
				panel.owner = this;
				PopUpEffect.Show(panel,this.parentApplication as DisplayObject,false);
			}
			
			private function orderToPrice(item:Orders):ArrayCollection{
				var result:ArrayCollection = new ArrayCollection();
				if(item!=null&&item.list!=null){
					for(var i:int=0;i<item.list.length;i++){
						result.addItem(detailToPrice(item.list.getItemAt(i) as OrderDetails));
					}
				}
				return result;
			}
			private function detailToPrice(item:OrderDetails):WorkPrice{
				var weightAll:Number = 0;//总重量
				var amountAll:Number = 0;//总金额
 				var detailList:ArrayCollection = new ArrayCollection();
				if(item.aluPro==null){
					var aluPro:AluPro = AluPro.getAluProById(item.ylType);
					item.aluPro = aluPro;
				}
				var workMaterial:WorkMaterial;
				var priceDetail:WorkPriceDetail;
				if(item.wkList!=null&&item.wkList.length>0){
					//计算外框总重量
					for(var i:int=0;i<item.wkList.length;i++){
						workMaterial = item.wkList.getItemAt(i) as WorkMaterial;
						priceDetail = workMaterialToPriceDetail(item,workMaterial);
						//总计
						weightAll += priceDetail.weight;
						amountAll += priceDetail.amount;
						detailList.addItem(priceDetail);
					}
				}
				if(item.nsList!=null&&item.nsList.length>0){
					//计算内扇总重量
					for(var i:int=0;i<item.nsList.length;i++){
						workMaterial = item.nsList.getItemAt(i) as WorkMaterial;
						priceDetail = workMaterialToPriceDetail(item,workMaterial);
						//总计
						weightAll += priceDetail.weight;
						amountAll += priceDetail.amount;
						detailList.addItem(priceDetail);
					}
				}
				
				var obj:WorkPrice = new WorkPrice();
				var name:String="";
				name +=item.aluPro.name+" ";
				name +=(item.color+" ");
				name += item.boLi==1?"单玻":"双玻";
				obj.name = name;
				obj.size = item.height+"×"+item.width;
				obj.area = DataFormat.formatNumber2(item.height*item.width*item.num*0.0001);
				
				obj.weight = DataFormat.formatNumber2(weightAll);
				obj.loss = item.aluPro.loss;
				obj.price = item.aluPro.price;
				obj.amount = DataFormat.formatNumber2(amountAll);
				obj.unitPrice = DataFormat.formatNumber2(obj.amount/obj.area);
				obj.detail = detailList; 
				return obj;
				
			}
			
			//物料明细转报价明细
			private function workMaterialToPriceDetail(item:OrderDetails,workMaterial:WorkMaterial):WorkPriceDetail{
				
				var aluProDetail:AluProDetail = AluProDetail.getAluProByIdAndNameStart(item.ylType,workMaterial.name);
				var unitWeight:Number = 0;
				if(aluProDetail!=null){
					unitWeight = item.boLi==2?aluProDetail.unitWeightDouble:aluProDetail.unitWeight;
				}
				//料重量 = 长度 * 根数 * 0.01 * 每米多少kg
				var theWeight:Number = workMaterial.length*workMaterial.num*0.01*unitWeight;
				
				var priceDetail:WorkPriceDetail = new WorkPriceDetail();
				priceDetail.name = workMaterial.name;
				priceDetail.length = workMaterial.length;
				priceDetail.number = workMaterial.num;
				priceDetail.weight = DataFormat.formatNumber2(theWeight);
				priceDetail.unitWeight = unitWeight;
				//金额 = 重量 * 1.13 * 单价
				priceDetail.amount = DataFormat.formatNumber2(theWeight*item.aluPro.loss*item.aluPro.price);
				return priceDetail;				
			}
			
		]]>
	</fx:Script>
