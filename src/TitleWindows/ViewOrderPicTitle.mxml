					//重新加载text
				}   */
				//Alert.show(event.currentTarget.document.winPic[event.currentTarget.currentIndex]);
			}
			//给所有窗型图加参数
			public function initAllImage():void{
				var am:Array=winPic;
				for(var i:int=0;i<am.length;i++){
					var orderm:OrderDetails=item_z.list.getItemAt(i) as OrderDetails;
					var picBlList:ArrayCollection=entity.PicBL.getBlbyParam(orderm.picName);
					var theWinPic:Image=winPic[i];
					FileUtil.autoSetBlValueOnPic(theWinPic,orderm.blList,picBlList,"smallText10");
				}
			}
			[Bindable]
			public function hboxWidthTop(data:OrderDetails,type:String):int{
				if(data.cxType==1){
					return 0;
				}
				if(data.zzNumTop>0){
					var tag:int=0;
					if(type==""){
						return int(widthPic/(data.zzNumTop+1));//+1 是因为1个中庭有2个hbox
					}else{
						return int(widthPic/(data.zzNumTop+1))+1+tag;//这里多+1 是因为hbox 间隔为-1 所以第二个开始就必须这样
					}
				}else{
					return widthPic;
				}
			}
			[Bindable]
			public function hboxWidthDown(data:OrderDetails,type:String):int{
				if(data.cxType==1){
					return 0;
				}
				if(data.zzNumDown>0){
					var tag:int=0;
					if(type==""){
						return int(widthPic/(data.zzNumDown+1));
					}else{
						return int(widthPic/(data.zzNumDown+1))+1+tag;
					}
				}else{
					return widthPic;
				}
			}
			[Bindable]
			public function getPrintMsg_tit_1(orderm:OrderDetails):String{
				
				var result:String="";
				result+=orderm.aluPro.name+" ";
				result+=(orderm.color+" ");
				
				if(orderm.boLi==1){
					result+="单玻 ";
				}else if(orderm.boLi==2){
					result+="双玻 ";
				}
				if(orderm.num>1){
					result+="(×"+orderm.num+"个)";
				}
				return result;
			}
