			public function show(_item:Orders,_aluProArray:ArrayCollection):void{
				
				this.item_z=_item;
				if(_aluProArray==null){
					_aluProArray = AluPro.getAluPros();
				}
				this.aluProArray=_aluProArray;
				//型材配置+玻璃配置   赋值
				if(item_z!=null&&item_z.list!=null&&item_z.list.length>0){
					var _area:Number=0;
					var order_m:OrderDetails;
					for(var i:int=0;i<item_z.list.length;i++){
						order_m = item_z.list.getItemAt(i) as OrderDetails;
						//order_m.setAluPro(aluProArray);
						if(order_m.cxType==0){
							calc(order_m);/**计算每个窗户的用料*/
							_area+= DataFormat.formatNumber2(order_m.height*order_m.width*order_m.num*0.0001);
						}else{
							calcCust(order_m);
							//area>0,说明自定义公式定义了面积,否则走width*height
							if(order_m.area>0){
								_area+= DataFormat.formatNumber2(order_m.area*order_m.num*0.0001);
							}else{
								_area+= DataFormat.formatNumber2(order_m.height*order_m.width*order_m.num*0.0001);
							}
						}
					}
					item_z.area=_area;
				}
			}
			
			public function initImage1(event:FlexEvent):void
			{
				return;
				var data:OrderDetails = event.currentTarget.currentItem as OrderDetails;
				if(data.cxType==0||data.picName==null||data.picName==""){
					return;
				}
				if(event.currentTarget.document.winPic==null){
					return;
				}
				var picBlList:ArrayCollection=entity.PicBL.getBlbyParam(data.picName);
				var theWinPic:Image=winPic[event.target.instanceIndices] as Image;
				FileUtil.autoSetBlValueOnPic(theWinPic,data.blList,picBlList);
				/* var _winpicArr:Array = winPic;
				for(var i:int =0;i<_winpicArr.length;i++){
