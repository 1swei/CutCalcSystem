        private var filterArray:Array = new Array();

        private function dataArray_refrech():void {
            var str:String = "";
            if ((str = StringUtil.trim(textIn.text)).length > 0) {
                filterArray = str.split(" ");
            } else {
                filterArray = new Array();
            }
            var array:ArrayCollection = new ArrayCollection(dataAllArray.toArray());
            if (array != null && array.length > 0) {
                array.filterFunction = rwbAllArrayFilterFunction;
                array.refresh();
            }
            dataArray = new ArrayCollection(array.toArray());
            Common.setRowNo(dataArray);
        }

       

        private function rwbAllArrayFilterFunction(item:Orders):Boolean {
            var result:Boolean = true;
            //出库类别
            /* if(result&&this.View.rkType.selectedItem.cmd!="RKD"&&this.View.rkType.selectedItem.cmd!=rwb.rwb003){
            result = false;
            } */
            if (result && stateIn.selectedIndex > 0) {
                if (stateIn.selectedIndex == 1 && item.stateIn != "N") {
                    result = false;
                } else if (stateIn.selectedIndex == 2 && item.stateIn != "Y") {
                    result = false;
                }

            }
            if (result && stateOut.selectedIndex > 0) {
                if (stateOut.selectedIndex == 1 && item.stateOut != "N") {
                    result = false;
                } else if (stateOut.selectedIndex == 2 && item.stateOut != "Y") {
                    result = false;
                }

            }
            if (result && item.xdTime != null) {
                if (beginDate.selectedDate != null
                        && DateFormatHelper.Format1(beginDate.selectedDate) > item.xdTime) {
                    result = false;
                }
                if (endDate.selectedDate != null
                        && DateFormatHelper.Format1(endDate.selectedDate) + " 24:59" <= item.xdTime) {
                    result = false;
                }
            }
            if (result && filterArray != null && filterArray.length > 0) {
                var i:int = filterArray.length;
                for each(var s:String in filterArray) {
                    if (s == null || (s = StringUtil.trim(s)).length <= 0) {
                        i--;
                        continue;
                    }
                    if ((item.khName != null && item.khName.indexOf(s) > -1)
                            || (item.zhaiyao != null && item.zhaiyao.indexOf(s) > -1)
                            || (item.bz != null && item.bz.indexOf(s) > -1)
                    ) {
                        i--;
                    }
                }
                result = (i == 0 ? true : false);
            }


            return result;

        }

        public function deleteDate():void {
