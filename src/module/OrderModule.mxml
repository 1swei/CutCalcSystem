            }
            if (item.list != null && item.list.length == 0) {
                item.list.addItem(new OrderDetails());
            }
            PopUpEffect.Show(panel, this,false);
            panel.setData(item, item.list.getItemAt(0) as OrderDetails);
            panel.addEventListener("REFRESHORDERDATA", function (e:Event):void {
                getOrders();
            });
        }

