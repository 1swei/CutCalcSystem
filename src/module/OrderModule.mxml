        private function alertCloseHandler(e:CloseEvent):void {
            if (e.detail == Alert.YES) {
                statement.text = "delete from Orders where id=" + dataGrid.selectedItem.id + "";
                statement.execute();
                statement.text = "delete from OrderDetails where orderId=" + dataGrid.selectedItem.id + "";
                statement.execute();
                getOrders();
            }
        }
        private var selecteds:ArrayCollection;//订单集合
        public function createSell():void {
            selecteds=new ArrayCollection();
            var khArray:Array = new Array();//客户 去重
            for each(var item:Orders in dataArray) {
                if (item.checked) {
                    selecteds.addItem(item);
                    if(khArray.indexOf(item.khName)==-1){
                        khArray.push(item.khName);
                    }
                }
            }
            if (selecteds.length == 0) {
                Alert.show("请先勾选需要生成销售的订单", "提示");
                return;
            }
            var khStr:String = "";
            for(var i :int=0;i<khArray.length;i++){
                khStr+=khArray[i]+" ";
            }
            Alert.show("本次将生成 " + khStr + " 的销售出货单，是否继续？", "提示", Alert.YES | Alert.CANCEL, null, createSellHandler);
        }

        private function createSellHandler(e:CloseEvent):void {
            if (e.detail == Alert.YES) {
                autoCreateSell(selecteds);
            }
        }
        private function autoCreateSell(array:ArrayCollection):void{
            var custNames:Array=new Array();
            var sellArray:ArrayCollection=new ArrayCollection();
            for(var i:int=0;i<array.length;i++){
                var order:Orders=array.getItemAt(i) as Orders;
                if(custNames.indexOf(order.khName)==-1){//该客户本次未插入过
                    custNames.push(order.khName);
                    var customers:ArrayCollection=Customer.getCustomerByName(order.khName);
                    var cust:Customer = customers.length>0?(customers.getItemAt(0) as Customer):null;

                    var sell:Sell=new Sell();
                    if(cust!=null){
                        sell.custId=cust.id;
                    }
                    sell.state=DataState.SAVED;
                    sell.custName=order.khName;
                    sell.custPhone=order.khPhone;
                    sell.custAddress=order.khAddress;
                    sell.memo = order.bz;
                    sellArray.addItem(sell);
                }else{
                    var repeatSell:Sell=ArrayCollectionUtil.getItem(order.khName,sellArray,"custName") as Sell;
                    if(repeatSell!=null){
                        repeatSell.memo+=" "+order.bz;
                    }
                }
            }
            for each(var sell:Sell in sellArray){
                sell.createTime=DateFormatHelper.Format10(new Date());
                Sell.insert(sell);
            }
            Alert.show("销售单创建成功","提示");
        }
        public function update(id:int, type:String):void {
            if (type == "Out") {
                statement.text = "update Orders set stateOut='Y' where id=" + id + "";
            } else {
                statement.text = "update Orders set stateIn='Y' where id=" + id + "";
            }
            statement.execute();
            getOrders();
        }

