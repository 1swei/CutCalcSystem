            var item:Orders = dataGrid.selectedItem as Orders;
            setItemList(item);
            showOrderDetailPanel(item);
        }

        public function setItemList(item:Orders):void {
            item.list = getOrderDetailsById(item.id);
            var order_m:OrderDetails;
            //给型材配置赋值不然点加号再选玻璃报错。
            for (var i:int = 0; i < item.list.length; i++) {
                order_m = item.list.getItemAt(i) as OrderDetails;
                order_m.setAluPro(aluProArray);
                order_m.blList = OrderDetailBL.getbyParam(order_m.id);
            }
        }

